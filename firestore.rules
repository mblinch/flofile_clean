rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin: custom claim (preferred) or configured owner email.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'projectflofile@gmail.com' ||
        request.auth.token.email == 'dev@flofilecaptions.com'
      );
    }

    // Global app originals — verbs, IPTC catalog, caption style defaults.
    // Readable by anyone (no auth needed) so defaults load without sign-in.
    // Only the admin account may write.
    match /appDefaults/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Existing roster data (teams/players) — keep permissive for sync jobs;
    // tighten separately if you add rules for sports/** paths.
    match /sports/{sportId}/teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if false;
      match /players/{playerId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // Tank01 RapidAPI mirror — same shape as sports/...; admin may sync from
    // the app, signed-in users may read.
    match /sports_tank01/{sportId}/teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /players/{playerId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /roster_sync/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Per-user settings (captions, verbs, FTP profiles, etc.).
    match /users/{userId}/preferences/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
