rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin: custom claim (preferred) or configured owner email.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'projectflofile@gmail.com' ||
        request.auth.token.email == 'dev@flofilecaptions.com'
      );
    }

    // Global app originals — verbs, IPTC catalog, caption style defaults.
    // Readable by anyone (no auth needed) so defaults load without sign-in.
    // Only the admin account may write.
    match /appDefaults/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // League-API roster cache — signed-in read; writes via sync jobs / Admin SDK.
    match /sports/{sportId} {
      allow read: if isSignedIn();
      allow write: if false;
      match /teams/{teamId} {
        allow read: if isSignedIn();
        allow write: if false;
        match /players/{playerId} {
          allow read: if isSignedIn();
          allow write: if false;
        }
      }
    }

    // Tank01 RapidAPI mirror — admin may edit from website admin + desktop app;
    // signed-in users may read.
    match /sports_tank01/{sportId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /teams/{teamId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
        match /players/{playerId} {
          allow read: if isSignedIn();
          allow write: if isAdmin();
        }
      }
    }

    match /roster_sync/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Signed-in users may file a report when they hit a roster conflict UI.
    // Admins read them; a Cloud Function emails the owner on create.
    match /roster_issue_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.kind is string
        && request.resource.data.teamName is string;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Per-user settings (captions, verbs, FTP profiles, etc.).
    match /users/{userId}/preferences/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
